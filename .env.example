# Réglages de l'application Robust ASR. Copiez ce fichier en .env, à la racine du dépôt, pour les
# modifier : docker compose et docker/start.sh le lisent automatiquement. Valeurs par défaut indiquées.

# --- Accès ------------------------------------------------------------------------------------------
# Adresse et port de l'interface. 127.0.0.1 : accessible depuis cette machine seulement.
ASR_BIND_ADDRESS=127.0.0.1
ASR_PORT=8080
# Noms d'hôte acceptés dans la barre d'adresse (protection contre le « DNS rebinding »).
ASR_ALLOWED_HOSTS="localhost 127.0.0.1"

# --- Modèle -----------------------------------------------------------------------------------------
# Dossier des versions de modèle sur l'hôte, et version chargée au démarrage.
ASR_MODELS_HOST_DIR=./models
ASR_MODEL_VERSION=v1
# Périphérique : auto (GPU si utilisable, sinon CPU), cuda (GPU exigé) ou cpu.
ASR_DEVICE=auto
# Threads CPU de PyTorch (vide : choix automatique).
ASR_NUM_THREADS=

# --- Limites ----------------------------------------------------------------------------------------
# Taille maximale d'un fichier envoyé, en Mo.
ASR_MAX_UPLOAD_MB=25
# Durée maximale de l'audio, en s (vide : celle du modèle, 30 s ; on ne peut que la réduire).
ASR_MAX_DURATION_S=
# Délai maximal d'une transcription, en s.
ASR_INFERENCE_TIMEOUT_S=120

# --- Journaux et documentation ---------------------------------------------------------------------
ASR_LOG_LEVEL=INFO
# Documentation interactive de l'API sur http://localhost:8080/api/docs.
ASR_ENABLE_DOCS=true
