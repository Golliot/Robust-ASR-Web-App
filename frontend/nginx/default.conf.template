# Nginx de l'interface Robust ASR. Gabarit : les variables ${...} en majuscules sont remplacées au
# démarrage du conteneur (voir limits.envsh) ; les variables Nginx ($host…) restent intactes.

server_tokens off;
log_format robust_asr '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                      '$request_time rid=$request_id';

# Hôte inconnu (autre nom de domaine pointant sur cette machine) : refusé, contre le « DNS rebinding ».
server {
    listen 8080 default_server;
    server_name _;
    access_log /dev/stdout robust_asr;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 421;
    }
}

server {
    listen 8080;
    server_name ${NGINX_SERVER_NAMES};
    root /usr/share/nginx/html;
    access_log /dev/stdout robust_asr;
    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    error_page 413 @too_large;
    error_page 502 504 @backend_unavailable;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API : relayée au backend, qui n'est pas exposé hors du réseau interne Docker.
    location /api/ {
        proxy_pass ${ASR_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout ${NGINX_PROXY_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_TIMEOUT};
        # Le fichier est reçu en entier avant d'être transmis : un envoi lent n'occupe pas le backend.
        proxy_request_buffering on;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Fichiers compilés : noms à empreinte, mis en cache longtemps.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Application monopage : toute autre adresse renvoie index.html, jamais mis en cache.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location @too_large {
        default_type application/json;
        return 413 '{"error":{"code":"FILE_TOO_LARGE","message":"Fichier trop volumineux.","request_id":"$request_id"}}';
    }

    location @backend_unavailable {
        default_type application/json;
        return 502 '{"error":{"code":"BACKEND_UNAVAILABLE","message":"Le service de transcription est injoignable ou n\'a pas répondu à temps.","request_id":"$request_id"}}';
    }
}
